# ==========================================
# Unitale 项目 .gitignore
# ==========================================

# === 1. IDE / 编辑器配置 ===
.vscode/
.idea/
*.swp
*.swo
*~

# === 2. 操作系统临时文件 ===
.DS_Store
Thumbs.db
desktop.ini

# === 3. Chrome 测试产物 / 崩溃转储（含敏感环境变量，严禁提交）===
.chrome-test/
*.dmp
*.pma
Crashpad/
crashpad/

# === 4. 日志和缓存 ===
*.log
*.cache
.eslintcache
__pycache__/
*.py[cod]
*$py.class

# === 5. Python 虚拟环境 ===
venv/
.venv/
env/
ENV/

# === 6. Node 依赖 ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === 7. 密钥 / 配置文件（千万不要提交）===
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
config.local.json

# === 8. 本地备份目录（不应进版本库）===
备份/
_backup/
backups/

# === 9. 大型本地资源（按需保留本地）===
人物声音/
voice/
voice/old/

# === 10. Build 产物 ===
dist/
build/

# === 不要上传的大型工程存档（>50MB JSON）===
Unitale Basic Project for EN.json
初始音效工程文件*.json
初始工程文件*.json
Unitale工程文件_*.json

# === 截图目录（非文档，避免污染）===
截图/
*.min.css
*.min.js

# === 临时音色、音频导出，不应进版本库 ===
timbres/*.wav
timbres/*.mp3
storyforge_export_*.wav
storyforge_export_*.mp3

repro_input.txt

# === 不要上传的导出 wav / 大音频 ===
*.export.wav
*.export.mp3
orig_export*

# === 备份文件不上传 ===
*.备份.md
api.py备份.md
*备份*

